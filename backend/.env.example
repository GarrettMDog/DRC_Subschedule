# Where the SQLite file lives. On Render, point this at your persistent disk mount,
# e.g. /var/data/subschedule.db (same pattern as Bedrock).
DB_PATH=./db/subschedule.db

# Entra ID app registration (same tenant as Bedrock, separate app registration)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Vercel URL for the frontend, for CORS
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
