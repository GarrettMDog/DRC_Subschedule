# Entra ID app registration (same tenant as Bedrock, separate app registration)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# Where the backend is running
VITE_API_BASE=http://localhost:4000

# Google Places API key, for address autocomplete on the job address field.
# Restrict this key in Google Cloud Console to (a) only the Places API, and
# (b) only your actual hosting domain(s) as HTTP referrers — this key is
# necessarily visible in the browser, same as any client-side API key; the
# referrer restriction, not secrecy, is what keeps it safe to use here.
# Leave blank to just get a plain text field with no suggestions.
VITE_GOOGLE_PLACES_API_KEY=
